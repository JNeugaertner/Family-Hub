        <mxCell id="c129" value="&lt;b style=&quot;font-size:14px&quot;&gt;Zusatzregeln&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Individuelle Rechte:&lt;/b&gt; Administratoren können einzelnen Personen Rechte unabhängig von der Rolle geben oder entziehen. &lt;i&gt;(Rollenkonzept)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Altersübergang:&lt;/b&gt; Kind wird ab 13 Jahren automatisch Jugendlicher. &lt;i&gt;(Entscheidung vom 22.09.2026)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Familiengrenzen:&lt;/b&gt; höchstens 2 Erwachsene und 5 Kinder. &lt;i&gt;(User Story A.1)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Spielverabredungen:&lt;/b&gt; nur Eltern entscheiden. &lt;i&gt;(User Story 6.2)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Sprachassistent:&lt;/b&gt; erkennt die Person per Stimme und beachtet ihre Rechte. &lt;i&gt;(User Story 7)&lt;/i&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;spacingRight=12;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="398" width="420" height="262" as="geometry"/></mxCell>
        <mxCell id="c130" value="&lt;b style=&quot;font-size:14px&quot;&gt;Freigabe-Workflow&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;spacingRight=12;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="676" width="420" height="345" as="geometry"/></mxCell>
        <mxCell id="c131" value="Jugendlicher, Kind oder KI-Agent&lt;br&gt;erstellt einen Vorschlag" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#FFE0B2;fontColor=#7C2D12;" vertex="1" parent="1"><mxGeometry x="1230" y="716" width="360" height="42" as="geometry"/></mxCell>
        <mxCell id="c132" value="Status: &lt;b&gt;Vorschlag&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1310" y="790" width="200" height="34" as="geometry"/></mxCell>
        <mxCell id="c133" value="&lt;b&gt;Administrator prüft&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#2563EB;fontColor=#FFFFFF;strokeColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="1310" y="856" width="200" height="34" as="geometry"/></mxCell>
        <mxCell id="c134" value="&lt;b&gt;Freigegeben&lt;/b&gt;&lt;br&gt;wird übernommen" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#D5E8D4;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1230" y="924" width="165" height="42" as="geometry"/></mxCell>
        <mxCell id="c135" value="&lt;b&gt;Abgelehnt&lt;/b&gt;&lt;br&gt;wird verworfen" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#F8CECC;fontColor=#7F1D1D;" vertex="1" parent="1"><mxGeometry x="1425" y="924" width="165" height="42" as="geometry"/></mxCell>
        <mxCell id="c136" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c131" target="c132"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c137" value="" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c132" target="c133"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c138" value="freigeben" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c133" target="c134"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c139" value="ablehnen" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c133" target="c135"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c140" value="&lt;i&gt;Beispiele: Terminvorschlag eines Jugendlichen, Einkaufswunsch eines Kindes, Essensvorschlag der KI (User Story 3.3.2)&lt;/i&gt;" style="text;html=1;fontSize=11;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1216" y="974" width="390" height="40" as="geometry"/></mxCell>
        <mxCell id="c141" value="&lt;b style=&quot;font-size:14px&quot;&gt;Umsetzung laut C4-Diagramm (MVP)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;spacingRight=12;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="1037" width="420" height="283" as="geometry"/></mxCell>
        <mxCell id="c142" value="&lt;b&gt;Kalender-, Termin- und Familienverwaltung-API&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#F1F5F9;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1230" y="1076" width="360" height="38" as="geometry"/></mxCell>
        <mxCell id="c143" value="&lt;b&gt;Anmeldung API&lt;/b&gt;&lt;br&gt;Benutzer anmelden" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1230" y="1160" width="165" height="46" as="geometry"/></mxCell>
        <mxCell id="c144" value="&lt;b&gt;Rechteverwaltung API&lt;/b&gt;&lt;br&gt;Rollen, Rechte, Prüfung" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#94A3B8;fontSize=11;fontFamily=Helvetica;fillColor=#DAE8FC;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="1425" y="1160" width="165" height="46" as="geometry"/></mxCell>
        <mxCell id="c145" value="&lt;b&gt;Datenbank&lt;/b&gt; (noSQL)" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;fontSize=11;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="1252" width="360" height="50" as="geometry"/></mxCell>
        <mxCell id="c146" value="Berechtigung prüfen" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c142" target="c144"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c147" value="Passwort prüfen" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.229;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c143" target="c145"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c148" value="Rechte speichern" style="endArrow=block;endFill=1;html=1;rounded=0;fontSize=10;strokeColor=#475569;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.771;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c144" target="c145"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c149" value="&lt;b style=&quot;font-size:14px&quot;&gt;Quellen&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Rollenkonzept.docx&lt;/b&gt;: Rollen, Berechtigungen und Einschränkungen (Basis der Matrix)&lt;br&gt;&lt;br&gt;• &lt;b&gt;User Stories mit Akzeptanzkriterien.docx&lt;/b&gt;: A.1 Profile, A.2 Rollen und Rechte, 3.3.2 KI-Vorschläge, 6.2 Spielverabredungen, 7 Sprachassistent&lt;br&gt;&lt;br&gt;• &lt;b&gt;C4 Diagramm.drawio&lt;/b&gt;: Seite C3_Component_MVP (Anmeldung API, Rechteverwaltung API)&lt;br&gt;&lt;br&gt;• &lt;b&gt;Personas (Mural)&lt;/b&gt;: nicht einbezogen, das Board erfordert eine Anmeldung" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;spacingRight=12;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="550" height="245" as="geometry"/></mxCell>
        <mxCell id="c150" value="&lt;b style=&quot;font-size:14px&quot;&gt;Abweichungen zwischen den Dokumenten&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;User Story A.2&lt;/b&gt; nennt nur 3 Rollen (Eltern, Kind, Agent), das Rollenkonzept hat 5.&lt;br&gt;&lt;br&gt;• &lt;b&gt;C4 Familienverwaltung API&lt;/b&gt; vergibt nur die Rollen Eltern und Kind.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Figma-UI&lt;/b&gt; kennt nur Mom, Dad und Child als Rollen.&lt;br&gt;&lt;br&gt;• &lt;b&gt;User Story A.1&lt;/b&gt; (max. 2 Erwachsene, 5 Kinder): offen, ob Jugendliche als Kinder zählen und ob Gäste mitzählen." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;spacingRight=12;fontSize=11;fontColor=#1E293B;fontFamily=Helvetica;fillColor=#FFFBEB;strokeColor=#F59E0B;" vertex="1" parent="1"><mxGeometry x="615" y="1075" width="550" height="245" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
