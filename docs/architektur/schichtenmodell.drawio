    <mxCell id="x6" value="&lt;b&gt;WhatsApp / Telegram&lt;/b&gt;&lt;br&gt;Bot-Schnittstelle" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#9ca3af;strokeColor=#6b7280;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="730" width="180" height="90" as="geometry"/></mxCell>
    <mxCell id="x7" value="&lt;b&gt;Sprach-Engine&lt;/b&gt;&lt;br&gt;Spracherkennung, Vorlesen" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#9ca3af;strokeColor=#6b7280;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="730" width="180" height="90" as="geometry"/></mxCell>
    <mxCell id="note" value="Ausnahme von der strengen Schichtung: Sprachdienst und Messenger-Gateway (Schicht 1) sprechen aus rein technischen Gründen direkt mit Sprach-Engine bzw. WhatsApp/Telegram, ohne die dazwischenliegenden Schichten zu durchlaufen. Alle fachlichen Integrationen (Kalender, Wetter, Müll, Fahrzeit, KI-Dienst) laufen ausschließlich über die Integrationsschicht (4a)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1420" height="60" as="geometry"/></mxCell>
    <mxCell id="foot" value="Konzeptstand, keine Implementierung. Farblegende entspricht den C4-Diagrammen (Level 2–4)." style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="40" y="935" width="900" height="20" as="geometry"/></mxCell>
