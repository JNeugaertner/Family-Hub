    <mxCell id="title" value="FamilyHub AI – Schichtenmodell" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="20" y="5" width="900" height="34" as="geometry"/></mxCell>
    <mxCell id="sub" value="Jede Schicht ruft nur die direkt darunterliegende Schicht auf; Datenhaltung und Integration liegen als Geschwisterschichten nebeneinander unter der Anwendungsschicht." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="20" y="38" width="1420" height="22" as="geometry"/></mxCell>
