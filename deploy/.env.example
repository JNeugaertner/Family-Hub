# Einstellungen für deploy/compose.yaml. Kopieren nach .env (im selben Ordner) und ausfüllen.
# .env enthält Passwörter und Schlüssel: nie einchecken und nicht weitergeben.

# --- Pflicht ---------------------------------------------------------------------------------------------------

# Passwort der Datenbank: nur Buchstaben und Ziffern (es steht in einer Adresse), mindestens 24 Zeichen.
# Erzeugen in PowerShell:  [guid]::NewGuid().ToString('N')      unter Linux/macOS:  openssl rand -hex 24
# Gilt nur beim allerersten Start. Wer es danach hier ändert, sperrt FamilyHub aus der Datenbank aus.
MONGO_PASSWORD=

# --- Optional --------------------------------------------------------------------------------------------------

# Adresse, unter der FamilyHub im Browser geöffnet wird, und der Port auf diesem Rechner (beide zusammen ändern)
FAMILYHUB_URL=http://localhost:8080
FAMILYHUB_PORT=8080

# Beispielfamilie zum Ausprobieren anlegen (alle Konten mit dem Passwort "familyhub"): nur für Tests auf true
FAMILYHUB_SAMPLEDATA_ENABLED=false

# Selbst gebautes Image statt des veröffentlichten verwenden (siehe README)
# FAMILYHUB_IMAGE=familyhub:lokal

# --- Zugangsdaten der Anbindungen (leer = „nicht eingerichtet“; Anleitungen im README) ---------------------------

# Wetter (OpenWeather)
FAMILYHUB_WEATHER_APIKEY=

# Google Kalender. Der Token-Schlüssel verschlüsselt die gespeicherten Google-Zugänge: danach nicht mehr ändern.
FAMILYHUB_GOOGLE_CLIENTID=
FAMILYHUB_GOOGLE_CLIENTSECRET=
FAMILYHUB_GOOGLE_TOKENKEY=

# Ortssuche und Fahrzeit (openrouteservice)
FAMILYHUB_ORS_APIKEY=

# Telegram-Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API (braucht zusätzlich eine öffentliche HTTPS-Adresse, kommt später)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
